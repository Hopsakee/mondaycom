# monday.com personal API token.
# Get it in monday.com: avatar (bottom left) > Developers > My access tokens.
API_KEY_MONDAY=paste-your-token-here

# Where `monday project` writes its Obsidian notes. Defaults to the vault's own
# projects folder; set it when the vault lives somewhere else on this machine.
